generator client {
  provider = "prisma-client-js"
  output   = "../../../node_modules/.prisma/core"
}

datasource db {
  provider = "postgresql"
  url      = env("CORE_DATABASE_URL")
}

enum SectionKind {
  TEXT
  EXERCISE
}

enum AuthProvider {
  CREDENTIALS
  GOOGLE
  GITHUB
}

model User {
  id           Int      @id @default(autoincrement())
  code         String   @unique
  email        String   @unique
  name         String
  avatarUrl    String?
  passwordHash String? // null para usuários OAuth puros
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  roles          UserRole[]
  createdTracks  Track[]          @relation("TrackCreator")
  enrollments    Enrollment[]
  progress       LessonProgress[]
  identities     UserIdentity[]
  passwordResets PasswordReset[]
  sectionViews   SectionView[]
}

model Role {
  id        Int        @id @default(autoincrement())
  name      String     @unique // "STUDENT", "TEACHER", "ADMIN"
  createdAt DateTime   @default(now())

  users     UserRole[]
}

model UserRole {
  userId    Int
  roleId    Int
  createdAt DateTime   @default(now())

  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  role      Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@index([userId])
  @@index([roleId])
}

model UserIdentity {
  id                Int          @id @default(autoincrement())
  userId            Int
  provider          AuthProvider
  providerAccountId String
  createdAt         DateTime     @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model PasswordReset {
  id        Int       @id @default(autoincrement())
  userId    Int
  tokenHash String    @unique // hash do token enviado por email
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Category {
  id        Int      @id @default(autoincrement())
  slug      String   @unique
  name      String
  color     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tracks    Track[]
}

model Track {
  id          Int       @id @default(autoincrement())
  slug        String    @unique
  title       String
  description String?
  creatorId   Int
  categoryId  Int?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  creator     User      @relation("TrackCreator", fields: [creatorId], references: [id], onDelete: Cascade)
  category    Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  lessons     Lesson[]
  enrollments Enrollment[]

  @@index([creatorId])
  @@index([categoryId])
}

model Lesson {
  id       Int    @id @default(autoincrement())
  trackId  Int
  slug     String
  title    String
  position Int

  track    Track            @relation(fields: [trackId], references: [id], onDelete: Cascade)
  sections Section[]
  progress LessonProgress[]

  @@unique([trackId, slug])
  @@unique([trackId, position])
}

model Section {
  id              Int         @id @default(autoincrement())
  lessonId        Int
  slug            String
  title           String
  position        Int
  kind            SectionKind @default(TEXT)
  contentMarkdown String // fonte da verdade do conteúdo; markdown é formato, não arquivo

  lesson   Lesson           @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  progress LessonProgress[]
  views    SectionView[]

  @@unique([lessonId, slug])
  @@unique([lessonId, position])
}

model Enrollment {
  id        BigInt   @id @default(autoincrement())
  userId    Int
  trackId   Int
  createdAt DateTime @default(now())

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  track Track @relation(fields: [trackId], references: [id], onDelete: Cascade)

  @@unique([userId, trackId])
}

model LessonProgress {
  id            BigInt    @id @default(autoincrement())
  userId        Int
  lessonId      Int
  lastSectionId Int?
  completedAt   DateTime?
  updatedAt     DateTime  @updatedAt

  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  lesson      Lesson   @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  lastSection Section? @relation(fields: [lastSectionId], references: [id], onDelete: SetNull)

  @@unique([userId, lessonId])
}

model SectionView {
  id        Int      @id @default(autoincrement())
  userId    Int
  sectionId Int
  viewedAt  DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  section Section @relation(fields: [sectionId], references: [id], onDelete: Cascade)

  @@unique([userId, sectionId])
  @@index([userId])
  @@index([sectionId])
}

model OutboxEvent {
  id          BigInt    @id @default(autoincrement())
  routingKey  String
  payload     Json
  headers     Json?
  retryCount  Int       @default(0)
  lastError   String?
  createdAt   DateTime  @default(now())
  publishedAt DateTime?

  @@index([publishedAt])
  @@index([publishedAt, retryCount])
}
