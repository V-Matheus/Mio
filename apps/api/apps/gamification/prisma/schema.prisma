generator client {
  provider = "prisma-client-js"
  output   = "../../../node_modules/.prisma/gamification"
}

datasource db {
  provider = "postgresql"
  url      = env("GAMIFICATION_DATABASE_URL")
}

model UserXp {
  userCode  String   @id
  total     Int      @default(0)
  updatedAt DateTime @updatedAt

  transactions XpTransaction[]
}

model XpTransaction {
  id        BigInt   @id @default(autoincrement())
  userCode  String
  amount    Int
  reason    String
  sourceId  String?
  createdAt DateTime @default(now())

  user UserXp @relation(fields: [userCode], references: [userCode], onDelete: Cascade)

  @@unique([userCode, sourceId])
  @@index([userCode, createdAt])
}

model OutboxEvent {
  id          BigInt    @id @default(autoincrement())
  routingKey  String
  payload     Json
  headers     Json?
  retryCount  Int       @default(0)
  lastError   String?
  createdAt   DateTime  @default(now())
  publishedAt DateTime?

  @@index([publishedAt])
  @@index([publishedAt, retryCount])
}

model XpRule {
  key         String   @id // Ex.: "LESSON_COMPLETED", "TRACK_COMPLETED", "SECTION_COMPLETED"
  amount      Int      @default(0)
  description String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}
