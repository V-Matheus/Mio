{
  "name": "@mio/api",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "postinstall": "yarn prisma:generate",
    "dev": "yarn docker:dev",
    "docker:dev": "yarn build:contracts && trap 'docker compose -p mio-dev -f ../../docker-compose.dev.yml down' EXIT INT TERM; docker compose -p mio-dev -f ../../docker-compose.dev.yml up --build postgres-core postgres-gamification postgres-achievements redis rabbitmq mailpit api-gateway api-core api-gamification api-achievements api-messenger api-notifications",
    "build:contracts": "yarn workspace @mio/grpc-contracts build",
    "dev:gateway": "nest start gateway --watch",
    "dev:core": "nest start core --watch",
    "dev:gamification": "nest start gamification --watch",
    "dev:achievements": "nest start achievements --watch",
    "dev:messenger": "nest start messenger --watch",
    "dev:notifications": "nest start notifications --watch",
    "build": "nest build gateway && nest build core && nest build gamification && nest build achievements && nest build messenger && nest build notifications && yarn build:ops",
    "build:ops": "tsc --project tsconfig.ops.json",
    "build:gateway": "nest build gateway",
    "build:core": "nest build core",
    "build:gamification": "nest build gamification",
    "build:achievements": "nest build achievements",
    "build:messenger": "nest build messenger",
    "build:notifications": "nest build notifications",
    "start:gateway": "node dist/apps/gateway/apps/gateway/src/main",
    "start:core": "node dist/apps/core/apps/core/src/main",
    "start:gamification": "node dist/apps/gamification/apps/gamification/src/main",
    "start:achievements": "node dist/apps/achievements/apps/achievements/src/main",
    "start:messenger": "node dist/apps/messenger/apps/messenger/src/main",
    "start:notifications": "node dist/apps/notifications/apps/notifications/src/main",
    "prisma:generate": "for s in core gamification achievements; do prisma generate --schema=apps/$s/prisma/schema.prisma || exit 1; done",
    "prisma:migrate:dev": "for s in core gamification achievements; do prisma migrate dev --schema=apps/$s/prisma/schema.prisma || exit 1; done",
    "prisma:migrate:deploy": "for s in core gamification achievements; do prisma migrate deploy --schema=apps/$s/prisma/schema.prisma || exit 1; done",
    "docker:prisma:migrate:dev": "docker compose -p mio-dev -f ../../docker-compose.dev.yml exec api-core yarn workspace @mio/api prisma:migrate:dev",
    "docker:prisma:migrate:deploy": "docker compose -p mio-dev -f ../../docker-compose.dev.yml exec api-core yarn workspace @mio/api prisma:migrate:deploy",
    "seed:content": "node dist/apps/core/scripts/seed-content.js",
    "seed:gamification": "node dist/apps/gamification/scripts/seed-gamification.js",
    "seed:achievements": "node dist/apps/achievements/scripts/seed-achievements.js",
    "seed:all": "yarn seed:content && yarn seed:gamification && yarn seed:achievements",
    "seed:content:dev": "dotenv -e .env tsx apps/core/scripts/seed-content.ts",
    "seed:gamification:dev": "dotenv -e .env tsx apps/gamification/scripts/seed-gamification.ts",
    "seed:achievements:dev": "dotenv -e .env tsx apps/achievements/scripts/seed-achievements.ts",
    "docker:seed:content": "docker compose -p mio-dev -f ../../docker-compose.dev.yml exec api-core yarn workspace @mio/api seed:content:dev",
    "docker:seed:gamification": "docker compose -p mio-dev -f ../../docker-compose.dev.yml exec api-gamification yarn workspace @mio/api seed:gamification:dev",
    "docker:seed:achievements": "docker compose -p mio-dev -f ../../docker-compose.dev.yml exec api-achievements yarn workspace @mio/api seed:achievements:dev",
    "docker:seed:all": "yarn docker:seed:content && yarn docker:seed:gamification && yarn docker:seed:achievements",
    "prisma:studio:core": "dotenv -e .env -- sh -c 'CORE_DATABASE_URL=postgresql://$CORE_POSTGRES_USER:$CORE_POSTGRES_PASSWORD@localhost:$CORE_POSTGRES_PORT/$CORE_POSTGRES_DB prisma studio --schema=apps/core/prisma/schema.prisma --port 5555'",
    "prisma:studio:gamification": "dotenv -e .env -- sh -c 'GAMIFICATION_DATABASE_URL=postgresql://$GAMIFICATION_POSTGRES_USER:$GAMIFICATION_POSTGRES_PASSWORD@localhost:$GAMIFICATION_POSTGRES_PORT/$GAMIFICATION_POSTGRES_DB prisma studio --schema=apps/gamification/prisma/schema.prisma --port 5556'",
    "prisma:studio:achievements": "dotenv -e .env -- sh -c 'ACHIEVEMENTS_DATABASE_URL=postgresql://$ACHIEVEMENTS_POSTGRES_USER:$ACHIEVEMENTS_POSTGRES_PASSWORD@localhost:$ACHIEVEMENTS_POSTGRES_PORT/$ACHIEVEMENTS_POSTGRES_DB prisma studio --schema=apps/achievements/prisma/schema.prisma --port 5557'",
    "lint": "biome lint .",
    "format": "biome format --write .",
    "check-types": "tsc --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run --config vitest.unit.config.ts",
    "test:e2e": "vitest run --config vitest.e2e.config.ts",
    "test:cov": "vitest run --coverage",
    "test:watch": "vitest",
    "test:ui": "vitest --ui --coverage"
  },
  "dependencies": {
    "@apollo/server": "^5.5.1",
    "@as-integrations/express5": "^1.1.2",
    "@grpc/grpc-js": "^1.12.2",
    "@grpc/proto-loader": "^0.8.0",
    "@mio/grpc-contracts": "*",
    "@nestjs/apollo": "^13.4.2",
    "@nestjs/bullmq": "^12.0.0",
    "@nestjs/common": "^11.0.1",
    "@nestjs/core": "^11.0.1",
    "@nestjs/graphql": "^13.4.2",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/microservices": "^11.1.19",
    "@nestjs/platform-express": "^11.0.1",
    "@nestjs/terminus": "^11.0.0",
    "@node-rs/argon2": "^2.0.2",
    "@prisma/client": "^7.0.0",
    "@react-email/components": "^1.0.12",
    "@react-email/render": "^2.1.0",
    "amqplib": "^2.0.1",
    "bullmq": "^6.3.4",
    "graphql": "^16.14.0",
    "ioredis": "^6.0.0",
    "nanoid": "^5.0.9",
    "nodemailer": "^10.0.9",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@mio/testing-config": "*",
    "@mio/typescript-config": "*",
    "@nestjs/cli": "^11.0.0",
    "@nestjs/schematics": "^11.0.0",
    "@nestjs/testing": "^11.0.1",
    "@types/amqplib": "^0.10.8",
    "@types/express": "^5.0.0",
    "@types/ioredis": "^5.0.0",
    "@types/node": "^24.0.0",
    "@types/nodemailer": "^8.0.1",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@types/supertest": "^6.0.2",
    "dotenv-cli": "^11.0.0",
    "prisma": "^6.2.0",
    "source-map-support": "^0.5.21",
    "supertest": "^7.0.0",
    "ts-loader": "^9.5.2",
    "tsconfig-paths": "^4.2.0",
    "tsx": "^4.23.0"
  }
}
